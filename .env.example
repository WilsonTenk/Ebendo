# Copy to .env.local and fill in. Never commit .env.local.

# Public site URL (used for Paystack callback links and SMS links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Paystack (use sk_test_... until the business is verified and tested)
PAYSTACK_SECRET_KEY=

# Comma-separated emails allowed into /admin (they log in via Supabase Auth)
ADMIN_EMAILS=

# Shared secret for the reminder cron (Vercel Cron sends it as a Bearer token)
CRON_SECRET=

# SMS: leave SMS_PROVIDER empty to only log messages to the console
SMS_PROVIDER=        # "arkesel" or empty
ARKESEL_API_KEY=
SMS_SENDER_ID=Ebendo # max 11 chars, must be approved by the provider
